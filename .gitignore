# Build output is never committed or packaged into .wsplugin.
build/
build-msvc/
build-qt/
build-vimcore/
dist/
CMakeFiles/
*.obj
*.pdb
*.ilk
__pycache__/
*.pyc

# rename.exe is a build artifact (CMake writes it to the source dir, because
# plugin.json names it as runtime.program). It ships as a release asset
# (.wsplugin), not through git. A fresh clone rebuilds it with CMake.
rename.exe
rename-ui.exe
# Bundled only while Qt Widgets is outside WinShun's shared-Qt contract.
Qt6Widgets.dll

# Probe output: task-level build artifacts and logs live under build/<task>/,
# and only trimmed excerpts are kept as validation evidence.
probe/*.log
probe/*.exe
