{
  "$schema": "https://raw.githubusercontent.com/LingCore/WinShun-plugins/main/schema/plugin.schema.json",
  "manifest": 1,
  "id": "ra9fael.rename",
  "name": {
    "zh": "批量重命名",
    "en": "Batch Rename"
  },
  "version": "0.2.0",
  "minWinShun": "0.22.0",
  "description": {
    "zh": "批量重命名：选中一个文件夹或同目录的一组项目，按规则或文本方式预览并改名。单文件改名请用 Win顺 的 F2。",
    "en": "Batch rename a folder or a same-directory selection with rules or a text buffer. Use WinShun F2 for a single file."
  },
  "author": "ra9fael",
  "homepage": "https://github.com/ra9fael/winshun-rename",
  "license": "MIT",
  "runtime": {
    "mode": "resident",
    "program": "rename.exe",
    "qt": "host",
    "qtVersion": "6.12",
    "sandbox": "normal",
    "start": "lazy",
    "timeoutMs": 1500,
    "memoryMB": 256,
    "idleExitSec": 0,
    "encoding": "utf-8"
  },
  "permissions": [
    "ui",
    "files:read",
    "files:write"
  ],
  "commands": [
    {
      "id": "rename",
      "keyword": [
        "rename",
        "br",
        "批量重命名"
      ],
      "title": {
        "zh": "批量重命名",
        "en": "Batch Rename"
      },
      "description": {
        "zh": "选中文件或文件夹后右键，打开批量重命名窗口；文件夹读取其中内容，文件读取同级目录。",
        "en": "Select a file or folder and right-click; a folder opens its contents, a file opens its siblings."
      },
      "icon": "rename.png",
      "hint": {
        "zh": "选中文件或文件夹，或输入 br",
        "en": "select a file or folder, or type br"
      },
      "triggers": [
        {
          "files": {
            "kind": "any",
            "max": 1000,
            "title": {
              "zh": "批量重命名…",
              "en": "Batch rename…"
            }
          }
        }
      ]
    }
  ]
}
